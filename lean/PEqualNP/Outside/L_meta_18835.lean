set_option maxRecDepth 100000 in
theorem PEqualNP.Outside.L_meta_18835 : (PEqualNP.Represents.RepSizeAtMost (fun u v : Fin 42 => decide ((u.val < 21 ∧ v.val < 21 ∧ (v.val + 21 - u.val) % 21 ∈ [0, 5, 7, 17, 20]) ∨ (21 ≤ u.val ∧ 21 ≤ v.val ∧ (u.val + 21 - v.val) % 21 ∈ [0, 5, 7, 17, 20]))) 167) := by
  refine ⟨circuit, mono, by decide +kernel, ?_⟩
  intro u v
  let r := 42 * u.val + v.val
  have hr : r < 1764 := by dsimp [r]; omega
  have hbits := hcsFoldBits raw ⟨r,hr⟩ circuit.gates fan
  change (circuit.gates.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun k => w.getD k false)])
    (PEqualNP.Represents.oneEach u v)).getD circuit.output false = _
  rw [← raw_spec u v, ← hbits, ← hcsGetDBit, calculated]
  exact target_spec u v
