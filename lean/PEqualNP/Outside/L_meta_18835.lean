def table : BitVec 1764 := 

theorem mono : Monotone2 circuit := by
  intro g hg
  obtain ⟨⟨b,i,j⟩, _, rfl⟩ := List.mem_map.mp (show g ∈ codes.map asGate from hg)
  cases b <;> simp [asGate]

theorem fan : FanInTwo circuit := by
  intro g hg
  obtain ⟨ho,hl⟩ := mono g hg
  refine ⟨?_,hl⟩
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ho ⊢
  tauto

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem raw_spec : ∀ u v : Fin 42,
    (raw.map fun w => w.getLsbD (42 * u.val + v.val)) = oneEach u v := by
  decide +kernel

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem calculated : (circuit.gates.foldl hcsStep raw).getD circuit.output 0 = table := by
  decide +kernel

set_option maxHeartbeats 10000000 in
set_option maxRecDepth 100000 in
theorem target_spec : ∀ u v : Fin 42, table.getLsbD (42 * u.val + v.val) = decide ((u.val < 21 ∧ v.val < 21 ∧ (v.val + 21 - u.val) % 21 ∈ [0, 5, 7, 17, 20]) ∨ (21 ≤ u.val ∧ 21 ≤ v.val ∧ (u.val + 21 - v.val) % 21 ∈ [0, 5, 7, 17, 20])) := by
  decide +kernel

